rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function tripDoc(tripId) {
      return firestore.get(/databases/(default)/documents/trips/$(tripId));
    }
    function member(tripId) {
      return signedIn() && request.auth.uid in tripDoc(tripId).data.memberUids;
    }
    function editor(tripId) {
      return member(tripId) && tripDoc(tripId).data.roles[request.auth.uid] in ['owner', 'editor'];
    }
    match /trips/{tripId}/encrypted/{fileName} {
      allow read: if member(tripId);
      allow create, update: if editor(tripId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if editor(tripId);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
