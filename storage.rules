rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(tripId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }
    match /trips/{tripId}/encrypted/{fileName} {
      allow read: if member(tripId);
      allow write: if member(tripId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
