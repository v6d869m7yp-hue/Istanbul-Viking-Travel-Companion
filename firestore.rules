rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(tripId) {
      return signedIn() && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }
    function owner(tripId) {
      return member(tripId) && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'owner';
    }
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /trips/{tripId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(tripId);
      allow update, delete: if owner(tripId);
      match /members/{uid} {
        allow read: if member(tripId);
        allow create, update, delete: if owner(tripId);
      }
      match /envelopes/{envelopeId} {
        allow read, create, update: if member(tripId)
          && request.resource.data.keys().hasOnly(['ciphertext','metadata','updatedAt','updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() < 900000;
        allow delete: if owner(tripId);
      }
      match /devices/{deviceId} {
        allow read: if member(tripId);
        allow create, update: if member(tripId) && request.resource.data.uid == request.auth.uid;
        allow delete: if owner(tripId) || (member(tripId) && resource.data.uid == request.auth.uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
